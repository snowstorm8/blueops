root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.py]
indent_size = 4

# shfmt reads these settings
[{*.{sh,bash,bats},blueops}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = false

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
