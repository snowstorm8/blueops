{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueops.invalid/schemas/detection-rule-pack/0.1.0",
  "title": "BlueOps detection rule pack",
  "description": "A file of detection rules. Rules are data: conditions over assessment findings, inventory records and snapshot changes, correlated by clauses. Semantic checks (field names, clause references, regex safety) are done by `python -m shared.engine rules validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "pack", "rules"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
    "kind": { "const": "rule-pack" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "rules": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "nature": {
      "description": "observation: a confirmed configuration observation. indicator: a suspicious sign that benign activity can explain. correlated: several independent indicators that together raise a question. hypothesis: unverified; needs more data.",
      "enum": ["observation", "indicator", "correlated", "hypothesis"]
    },
    "condition": { "type": "object" },
    "expr": {
      "description": "Boolean expression over clause ids: \"a\", {\"all\": [...]}, {\"any\": [...]}, {\"not\": e}.",
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
        { "type": "object" }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
        "source": { "enum": ["findings", "inventory", "new_findings", "resolved_findings", "persistent_findings", "severity_increased", "config_changes", "snapshot"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "where": { "$ref": "#/$defs/condition" },
        "optional": { "type": "boolean" },
        "min_matches": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "distinct": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "count"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 2, "maximum": 100 }
          }
        },
        "join_on": { "type": "string", "minLength": 1 }
      }
    },
    "adjust": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "value", "reason"],
        "properties": {
          "when": { "$ref": "#/$defs/expr" },
          "value": { "type": "string" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" },
        "relationship": { "enum": ["direct", "possible"] },
        "explanation": { "type": "string", "minLength": 10, "maxLength": 600 }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expect": { "enum": ["match", "no_match", "indeterminate"] },
        "count": { "type": "integer", "minimum": 0 },
        "platform": { "enum": ["linux", "windows"] },
        "current": { "type": "object" },
        "previous": { "type": "array", "items": { "type": "object" } }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "description", "platforms", "category", "severity", "severity_reason", "confidence", "confidence_reason", "nature", "clauses", "title", "rationale", "investigation", "remediation", "examples"],
      "properties": {
        "id": { "type": "string", "pattern": "^DR-[A-Z]{2,4}-[A-Z0-9]{2,8}-\\d{3}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 120 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "enabled": { "type": "boolean" },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linux", "windows", "any"] } },
        "category": { "type": "string", "pattern": "^[a-z][a-z-]{1,31}$" },
        "severity": { "$ref": "#/$defs/severity" },
        "severity_reason": { "type": "string", "minLength": 10, "maxLength": 500 },
        "severity_rules": { "$ref": "#/$defs/adjust" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "confidence_reason": { "type": "string", "minLength": 10, "maxLength": 500 },
        "confidence_rules": { "$ref": "#/$defs/adjust" },
        "nature": { "$ref": "#/$defs/nature" },
        "requires_coverage": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^(module:[a-z0-9_-]+|inventory:[a-z_]+(:[A-Za-z0-9_.-]*)?|comparison(:exists)?|history:\\d{1,3})$" } },
        "clauses": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/clause" } },
        "require": { "$ref": "#/$defs/expr" },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on"],
          "properties": { "on": { "type": "string", "minLength": 1 }, "mode": { "enum": ["equal", "casefold"] } }
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 1500 },
        "false_positives": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 5 } },
        "confidence_boosters": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 5 } },
        "investigation": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 5 } },
        "remediation": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attack": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/attack" } },
            "nist": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[A-Z]{2}-\\d{1,2}(\\(\\d{1,2}\\))?$" } },
            "other": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 5, "maxLength": 300 } }
          }
        },
        "examples": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "$ref": "#/$defs/example" } }
      }
    }
  }
}
