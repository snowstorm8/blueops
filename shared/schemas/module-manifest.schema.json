{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueops.invalid/schemas/module-manifest/0.1.0",
  "title": "BlueOps assessment module manifest",
  "description": "Declares a plugin module for the assessment engine. Stored as <name>.module.json in a plugin directory. The command is executed directly (never through a shell) and must produce an audit-report document (see audit-report.schema.json). Only load plugin directories you trust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "platform", "category", "command"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
    "kind": { "const": "module" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_-]{0,47}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "platform": { "enum": ["linux", "windows", "any"] },
    "category": { "enum": ["audit", "persistence"] },
    "requires": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_-]{0,47}$" } },
    "provides": {
      "description": "Inventory partitions (domain:scope) the module owns; reported as unavailable coverage when the module does not run.",
      "type": "array",
      "items": { "type": "string", "pattern": "^(users|groups|services|processes|listeners|scheduled_tasks|persistence|config):[A-Za-z0-9_.-]{0,63}$" }
    },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "privilege": { "enum": ["none", "recommended", "required"] },
    "output": {
      "description": "run-dir: the command writes report.json under {output_dir} (directly or in a blueops-run-* subdirectory). stdout: the command prints the report on stdout.",
      "enum": ["run-dir", "stdout"]
    },
    "command": {
      "description": "argv template. Placeholders: {plugin_dir}, {output_dir}, {repo}, {module}.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
