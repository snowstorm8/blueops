          "expect": "match",
          "platform": "linux",
          "current": {
            "findings": [],
            "inventory": [
              {
                "domain": "config",
                "key": "config:core:core_pattern",
                "attrs": {
                  "value": "|/tmp/.x/handler %p"
                },
                "scope": "core"
              }
            ]
          }
        },
        {
          "name": "systemd-coredump",
          "expect": "no_match",
          "platform": "linux",
