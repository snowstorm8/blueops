      "id": "DR-LNX-SYS-001",
      "version": "1.0.0",
      "name": "Crash-dump handler runs an unrecognised program",
      "description": "kernel.core_pattern pipes crash dumps to a program that is not a known distribution handler.",
      "platforms": [
        "linux"
      ],
      "category": "system-config",
      "severity": "high",
      "severity_reason": "The kernel runs the handler as root whenever a process crashes, so whoever controls it has a root execution hook.",
      "confidence": "medium",
      "confidence_reason": "Site-specific handlers (for example crash collectors) are legitimate and not in the known list.",
      "nature": "indicator",
      "requires_coverage": [
        "inventory:config:core"
      ],
      "clauses": [
        {
          "id": "core",
          "source": "inventory",
          "description": "core_pattern pipes to a handler outside the known list",
          "where": {
            "all": [
              {
                "field": "domain",
                "op": "eq",
                "value": "config"
              },
              {
                "field": "key",
                "op": "eq",
                "value": "config:core:core_pattern"
              },
              {
                "field": "attrs.value",
                "op": "startswith",
                "value": "|"
              },
              {
                "not": {
                  "any": [
                    {
                      "field": "attrs.value",
                      "op": "startswith",
                      "value": "|/usr/lib/systemd/systemd-coredump"
                    },
                    {
                      "field": "attrs.value",
                      "op": "startswith",
                      "value": "|/lib/systemd/systemd-coredump"
                    },
                    {
                      "field": "attrs.value",
                      "op": "startswith",
                      "value": "|/usr/share/apport/apport"
                    },
                    {
                      "field": "attrs.value",
                      "op": "startswith",
                      "value": "|/usr/libexec/abrt-hook-ccpp"
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "title": "core_pattern pipes crashes to an unrecognised program",
      "rationale": "A crash handler is an unusual place to look for persistence, which is why it works: it executes as root with attacker-influenced crash data and survives reboots if set in sysctl.d.",
      "investigation": [
        "Identify the handler binary, its package owner and hash.",
        "Find where the setting is persisted (/etc/sysctl.conf, /etc/sysctl.d).",
        "Review recent root-owned file changes next to it."
      ],
      "remediation": "Restore the distribution default (kernel.core_pattern) in sysctl configuration after preserving the handler as evidence.",
      "references": {
        "attack": [
          {
            "id": "T1546",
            "relationship": "possible",
            "explanation": "A crash handler is an event-triggered execution point; this does not map to a more specific technique and no abuse is shown."
          }
        ],
        "nist": [
          "CM-6",
          "SI-7"
        ]
      },
      "examples": [
        {
