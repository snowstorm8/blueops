      "id": "DR-LNX-SVC-001",
      "version": "1.0.0",
      "name": "Legacy cleartext service enabled and listening",
      "description": "A legacy service known for cleartext authentication (telnet, r-services, tftp, FTP) is enabled and a matching process is listening.",
      "platforms": [
        "linux"
      ],
      "category": "services",
      "severity": "high",
      "severity_reason": "Credentials sent in cleartext and unauthenticated file transfer are directly exploitable on a reachable network.",
      "confidence": "medium",
      "confidence_reason": "Names identify the service; they do not prove it is reachable from untrusted networks.",
      "nature": "correlated",
      "requires_coverage": [
        "inventory:services",
        "inventory:listeners"
      ],
      "clauses": [
        {
          "id": "unit",
          "source": "inventory",
          "description": "A legacy cleartext service is enabled",
          "where": {
            "all": [
              {
                "field": "domain",
                "op": "eq",
                "value": "services"
              },
              {
                "field": "key",
                "op": "regex",
                "value": "^service:(telnet|rsh|rlogin|rexec|tftp|vsftpd|proftpd|pure-ftpd|xinetd|inetd)"
              },
              {
                "field": "attrs.enabled",
                "op": "in",
                "value": [
                  "enabled",
                  "static",
                  "yes"
                ]
              }
            ]
          }
        },
        {
          "id": "port",
          "source": "inventory",
          "description": "A matching legacy daemon is listening",
          "where": {
            "all": [
              {
                "field": "domain",
                "op": "eq",
                "value": "listeners"
              },
              {
                "field": "attrs.process",
                "op": "regex",
                "value": "(in\\.)?(telnetd|rshd|rlogind|rexecd|tftpd|vsftpd|proftpd|pure-ftpd|xinetd|inetd)"
              }
            ]
          }
        }
      ],
      "title": "Legacy cleartext service enabled and listening ({unit.key})",
      "rationale": "An enabled unit says the service starts at boot; a listening process says it is running now. Together they show an exposed cleartext service rather than a stray package.",
      "investigation": [
        "Confirm the service owner and whether the port is scored.",
        "Check the firewall policy for the listening port.",
        "Review authentication logs for the service."
      ],
      "remediation": "Disable the service in favour of SSH/SFTP once confirmed it is not required (disable, do not delete; reload dependants).",
      "references": {
        "attack": [
