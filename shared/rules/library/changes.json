          "expect": "no_match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "USR-SUDO-002",
                  "severity": "medium",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            },
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "system",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "failed"
              }
            }
          ]
        },
        {
          "name": "only one earlier snapshot",
          "expect": "indeterminate",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": []
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "system",
                  "confidence": "high"
                }
              ],
              "inventory": []
            }
          ]
        }
      ],
      "join": {
        "on": "id",
        "mode": "equal"
      }
    },
    {
      "enabled": true,
      "false_positives": [
        "Collector version upgrades that re-rate checks; look at evidence added."
      ],
      "confidence_boosters": [],
      "id": "DR-ANY-CHG-003",
      "version": "1.0.0",
      "name": "A finding's severity increased to high or critical",
      "description": "A finding that was present in the previous snapshot is now rated high or critical.",
      "platforms": [
        "any"
      ],
      "category": "change",
      "severity": "high",
      "severity_reason": "The same weakness got worse: more evidence, or a stronger indicator, since the last look.",
      "confidence": "high",
      "confidence_reason": "The severity values are taken directly from the two snapshots for the same finding id.",
      "nature": "indicator",
      "requires_coverage": [
        "comparison"
      ],
      "clauses": [
        {
          "id": "worse",
          "source": "severity_increased",
          "description": "A finding whose severity rose to high or critical",
          "where": {
            "field": "severity_rank",
            "op": "gte",
            "value": 3
          }
        }
      ],
      "title": "Severity increased to {worse.severity}: {worse.title}",
      "rationale": "A severity increase means the collector now sees stronger signs (for example a second uid-0 account on top of an existing one). It identifies where the situation worsened.",
      "investigation": [
        "Compare the evidence added since the previous snapshot (detail in contributing items).",
        "Check the collector versions of both snapshots.",
        "Investigate the added evidence items first."
      ],
      "remediation": "Address the added evidence; remediate the underlying finding as described by its own remediation text.",
      "references": {
        "nist": [
          "SI-4",
          "CM-3"
        ]
      },
      "examples": [
        {
          "name": "medium became critical",
          "expect": "match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-UID0-001",
                "severity": "critical",
                "category": "users",
                "confidence": "high",
                "evidence": [
                  {
                    "ref": "/etc/passwd",
                    "excerpt": "toor"
                  },
                  {
                    "ref": "/etc/passwd.bak",
                    "excerpt": "evil"
                  }
                ]
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "USR-UID0-001",
                  "severity": "medium",
                  "category": "users",
                  "confidence": "high",
                  "evidence": [
                    {
                      "ref": "/etc/passwd",
                      "excerpt": "toor"
                    }
                  ]
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            }
          ],
          "count": 1
        },
        {
          "name": "low became medium",
          "expect": "no_match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SHELL-001",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
