      "join": {
        "on": "id",
        "mode": "equal"
      }
    },
    {
      "enabled": true,
      "false_positives": [
        "Scheduled hardening or patch windows."
      ],
      "confidence_boosters": [],
      "id": "DR-ANY-CHG-004",
      "version": "1.0.0",
      "name": "Security-relevant configuration changed after a long stable period",
      "description": "A configuration record (sshd, sudoers, PAM, firewall, security policy, sysctl, event log, ...) changed after holding the same value in at least three earlier snapshots.",
      "platforms": [
        "any"
      ],
      "category": "change",
      "severity": "medium",
      "severity_reason": "A value that was stable for several assessments and then changed is more likely a deliberate act than routine churn.",
      "confidence": "medium",
      "confidence_reason": "The stability history is exact; the cause of the change is not.",
      "nature": "indicator",
      "requires_coverage": [
        "comparison",
        "history:3"
      ],
      "clauses": [
        {
          "id": "cfg",
          "source": "config_changes",
          "description": "A security-relevant config record changed after >= 3 stable snapshots",
          "where": {
            "all": [
              {
                "field": "domain",
                "op": "eq",
                "value": "config"
              },
              {
                "field": "change",
                "op": "eq",
                "value": "modified"
              },
              {
                "field": "scope",
                "op": "in",
                "value": [
                  "sshd",
                  "sudoers",
                  "pam",
                  "firewall",
                  "security",
                  "sysctl",
                  "eventlog",
                  "core",
                  "logindefs",
                  "logging"
                ]
              },
              {
                "field": "history.before_stable_snapshots",
                "op": "gte",
                "value": 3
              }
            ]
          }
        }
      ],
      "title": "Long-stable security setting changed: {cfg.key}",
      "rationale": "Baselines are most valuable for settings that rarely change. A change to one of those is a better lead than a change to a volatile value.",
      "investigation": [
        "Read the before and after values (detail of the contributing change).",
        "Check change records for the date between the two snapshots.",
        "Check who could have edited the file or registry key."
      ],
      "remediation": "Revert unapproved changes and investigate how the edit was made; record approved changes in the baseline.",
      "references": {
        "nist": [
          "CM-3",
          "CM-6"
        ]
      },
      "examples": [
        {
          "name": "sshd setting changed after 3 stable snapshots",
          "expect": "match",
          "platform": "linux",
          "current": {
            "findings": [],
            "inventory": [
              {
                "domain": "config",
                "key": "config:sshd:permitrootlogin",
                "attrs": {
                  "value": "yes"
                },
                "scope": "sshd"
              }
            ]
          },
          "previous": [
            {
              "findings": [],
              "inventory": [
                {
                  "domain": "config",
                  "key": "config:sshd:permitrootlogin",
                  "attrs": {
                    "value": "no"
                  },
                  "scope": "sshd"
                }
              ]
            },
            {
              "findings": [],
              "inventory": [
                {
                  "domain": "config",
                  "key": "config:sshd:permitrootlogin",
                  "attrs": {
                    "value": "no"
                  },
                  "scope": "sshd"
                }
              ]
            },
            {
              "findings": [],
              "inventory": [
                {
                  "domain": "config",
                  "key": "config:sshd:permitrootlogin",
                  "attrs": {
                    "value": "no"
                  },
                  "scope": "sshd"
                }
              ]
            }
          ],
          "count": 1
        },
        {
          "name": "changed after only two stable snapshots",
          "expect": "indeterminate",
          "platform": "linux",
          "current": {
            "findings": [],
