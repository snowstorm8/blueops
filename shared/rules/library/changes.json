{
  "schema_version": "0.1.0",
  "kind": "rule-pack",
  "pack": {
    "name": "changes",
    "version": "1.0.0",
    "description": "Rules over snapshot changes and history."
  },
  "rules": [
    {
      "enabled": true,
      "false_positives": [
        "Operating system or application upgrades, new deployments, a first run with additional modules enabled."
      ],
      "confidence_boosters": [
        "Package manager and deployment logs between the two snapshots.",
        "Whether the new findings share paths or accounts."
      ],
      "id": "DR-ANY-CHG-001",
      "version": "1.0.0",
      "name": "New findings appeared together after a clean assessment",
      "description": "The previous snapshot was complete and had no finding of medium severity or higher; this one has new medium-or-higher findings in at least two different areas.",
      "platforms": [
        "any"
      ],
      "category": "change",
      "severity": "medium",
      "severity_reason": "A sudden cluster of independent problems on a previously clean host deserves a look, but a patch or deployment can cause the same picture.",
      "severity_rules": [
        {
          "when": "critical_new",
          "value": "high",
          "reason": "At least one of the new findings is critical."
        }
      ],
      "confidence": "medium",
      "confidence_reason": "The previous snapshot was complete, so absence there is trustworthy; the cause of the change is unknown.",
      "nature": "correlated",
      "requires_coverage": [
        "comparison",
        "history:1"
      ],
      "clauses": [
        {
          "id": "clean",
          "source": "snapshot",
          "description": "The previous snapshot was complete and clean (no medium+ findings)",
          "where": {
            "all": [
              {
                "field": "previous.clean",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "fresh",
          "source": "new_findings",
          "description": "New medium-or-higher findings in at least two categories",
          "where": {
            "field": "severity_rank",
            "op": "gte",
            "value": 2
          },
          "distinct": {
            "field": "category",
            "count": 2
          }
        },
        {
          "id": "critical_new",
          "source": "new_findings",
          "description": "A new critical finding",
          "where": {
            "field": "severity",
            "op": "eq",
            "value": "critical"
          },
          "optional": true
        }
      ],
      "require": {
        "all": [
          "clean",
          "fresh"
        ]
      },
      "title": "New findings in several areas after a clean assessment",
      "rationale": "Independent new problems that appear together after a clean baseline usually share a cause: a deployment, a package change, or an intrusion.",
      "investigation": [
        "List the new findings and look for a common path, account or time.",
        "Check change records and package logs between the snapshots.",
        "Compare module coverage of the two assessments."
      ],
      "remediation": "Triage the new findings by severity; if the cause was an approved change, accept it into the baseline.",
      "references": {
        "nist": [
          "CM-3",
          "SI-4"
        ]
      },
      "examples": [
        {
          "name": "two new findings after clean",
          "expect": "match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              },
              {
                "check_id": "NET-EXPOSE-001",
                "severity": "high",
                "category": "network",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok",
              "network": "ok",
              "system": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "system",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok",
                "network": "ok",
                "system": "ok"
              }
            }
          ],
          "count": 1
        },
        {
          "name": "new finding in one area only",
          "expect": "no_match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              },
              {
                "check_id": "USR-SHELL-001",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok",
              "network": "ok",
              "system": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "system",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok",
                "network": "ok",
                "system": "ok"
              }
            }
          ]
        },
        {
          "name": "previous was not clean",
          "expect": "no_match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              },
              {
                "check_id": "NET-EXPOSE-001",
                "severity": "high",
                "category": "network",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok",
              "network": "ok",
              "system": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "USR-UID0-001",
                  "severity": "high",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok",
                "network": "ok",
                "system": "ok"
              }
            }
          ]
        },
        {
          "name": "previous coverage incomplete",
          "expect": "indeterminate",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              },
              {
                "check_id": "NET-EXPOSE-001",
                "severity": "high",
                "category": "network",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok",
              "network": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "system",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok",
                "network": "failed"
              }
            }
          ]
        },
        {
          "name": "no earlier snapshot",
          "expect": "indeterminate",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": []
          }
        }
      ]
    },
    {
      "enabled": true,
      "false_positives": [
        "Rollback of an environment to an earlier image; a flapping check at the edge of a threshold."
      ],
      "confidence_boosters": [],
      "id": "DR-ANY-CHG-002",
      "version": "1.0.0",
      "name": "A previously resolved finding has returned",
      "description": "A medium-or-higher finding that earlier snapshots recorded as resolved is present again.",
      "platforms": [
        "any"
      ],
      "category": "change",
      "severity": "medium",
      "severity_reason": "A fix that did not hold means a process re-applied the weakness: configuration management drift, a restored backup, or someone re-introducing it.",
      "confidence": "medium",
      "confidence_reason": "The finding id is stable across snapshots and absence in the earlier snapshot was confirmed by a clean module run.",
      "nature": "indicator",
      "requires_coverage": [
        "history:2"
      ],
      "clauses": [
        {
          "id": "back",
          "source": "findings",
          "description": "A medium+ finding that reappeared after being absent",
          "where": {
            "all": [
              {
                "field": "history.reappeared",
                "op": "is_true"
              },
              {
                "field": "severity_rank",
                "op": "gte",
                "value": 2
              }
            ]
          }
        }
      ],
      "title": "Finding returned after being resolved: {back.title}",
      "rationale": "Re-appearing findings point to something undoing remediation. That is more interesting than a persistent finding because it implies an active cause.",
      "investigation": [
        "Find what changed between the snapshots that included the fix and the re-appearance.",
        "Check configuration management and backup restores.",
        "Check whether the evidence is the same as before the fix."
      ],
      "remediation": "Fix the root cause that re-introduced it (configuration management, image, backup), then re-assess.",
      "references": {
        "nist": [
          "CM-3",
          "CM-6"
        ]
      },
      "examples": [
        {
          "name": "finding present, absent, present again",
          "expect": "match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "USR-SUDO-002",
                  "severity": "medium",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            },
            {
              "findings": [
                {
                  "check_id": "SYS-INFO-001",
                  "severity": "info",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            }
          ],
          "count": 1
        },
        {
          "name": "continuously present",
          "expect": "no_match",
          "platform": "linux",
          "current": {
            "findings": [
              {
                "check_id": "USR-SUDO-002",
                "severity": "medium",
                "category": "users",
                "confidence": "high"
              }
            ],
            "inventory": [],
            "modules": {
              "users": "ok"
            }
          },
          "previous": [
            {
              "findings": [
                {
                  "check_id": "USR-SUDO-002",
                  "severity": "medium",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            },
            {
              "findings": [
                {
                  "check_id": "USR-SUDO-002",
                  "severity": "medium",
                  "category": "users",
                  "confidence": "high"
                }
              ],
              "inventory": [],
              "modules": {
                "users": "ok"
              }
            }
