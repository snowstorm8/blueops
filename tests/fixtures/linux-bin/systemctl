*"list-unit-files"*) printf 'ssh.service enabled enabled\ntelnet.service enabled enabled\ncron.service enabled enabled\n' ;;
*"--state=failed"*) printf '● backup.service loaded failed failed Nightly backup\n' ;;
*"list-units"*) printf 'ssh.service loaded active running OpenBSD Secure Shell server\ncron.service loaded active running Regular background program processing\nbackup.service loaded failed failed Nightly backup\n' ;;
*) exit 1 ;;
esac
